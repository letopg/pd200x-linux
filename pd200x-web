class Meter(threading.Thread):
    """Keeps its own fd open and records the latest 0x2034 level packet.

    hidraw hands every input report to every open fd, so this doesn't take replies away from
    request transactions. Reopens the device after a replug.
    """

    def __init__(self, path=None):
        super().__init__(daemon=True)
        self.path, self.db, self.when = path, None, None

    def run(self):
        while True:
            try:
                fd = os.open(self.path or pd200x.find_node(), os.O_RDONLY)
            except (OSError, pd200x.DeviceError):
                time.sleep(1)
                continue
            try:
                while True:
                    if select.select([fd], [], [], 1.0)[0]:
                        p = pd200x.parse(os.read(fd, 64))
                        if p and p[0] == pd200x.T_WRITE and p[1][:1] == [pd200x.METER] and len(p[1]) > 1:
                            self.db, self.when = pd200x.db(p[1][1]), time.monotonic()
            except OSError:
                pass
            finally:
                os.close(fd)
            time.sleep(1)

    def snapshot(self):
        age = None if self.when is None else round(time.monotonic() - self.when, 2)
        return {"db": self.db, "age": age}


class Handler(BaseHTTPRequestHandler):
    device = None  # --device override
    meter = None

    def log_message(self, fmt, *args):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body.encode() if isinstance(body, str) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        try:
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass  # browser went away mid-reply (tab closed, page reloaded)

    def _host_ok(self):
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
        return host in ("127.0.0.1", "localhost")

    def _with_device(self, fn):
        try:
            with pd200x.PD200X(self.device) as dev:
                return self._send(200, fn(dev))
        except ValueError as e:
            return self._send(400, {"error": str(e)})
        except (pd200x.DeviceError, OSError) as e:
            return self._send(503, {"error": str(e)})

    def do_GET(self):
        if not self._host_ok():
            return self._send(403, {"error": "bad host"})
        if self.path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if self.path == "/api/status":
            def status(dev):
                s = pd200x.decode(dev.read_block(pd200x.REG_FIRST, pd200x.REG_LAST))
                s["identity"] = dev.identity()
                s["path"] = dev.path
                return s
            return self._with_device(status)
        if self.path == "/api/meter":
            return self._send(200, self.meter.snapshot())
        self._send(404, {"error": "not found"})

    def do_POST(self):
        if not self._host_ok():
            return self._send(403, {"error": "bad host"})
        if self.headers.get("Content-Type", "").split(";")[0] != "application/json":
            return self._send(415, {"error": "expected application/json"})
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        except ValueError:
            return self._send(400, {"error": "bad json"})
        if self.path == "/api/set":
            return self._with_device(lambda dev: pd200x.set_setting(dev, body.get("key"), body.get("value")) or {"ok": True})
        if self.path == "/api/eq":
            fields = {k: body.get(k) for k in ("on", "freq", "gain", "q")}
            return self._with_device(lambda dev: pd200x.set_band(dev, str(body.get("band")), **fields) and {"ok": True})
        self._send(404, {"error": "not found"})


def main():
    ap = argparse.ArgumentParser(prog="pd200x-web", description="Local web UI for the Maono PD200X")
    ap.add_argument("--port", type=int, default=8200)
    ap.add_argument("--device", help="hidraw node (default: auto-detect)")
    args = ap.parse_args()
    Handler.device = args.device
    Handler.meter = Meter(args.device)
    Handler.meter.start()
    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    print(f"pd200x-web: http://127.0.0.1:{args.port}/  (Ctrl-C to stop)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
