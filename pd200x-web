  const key = el.dataset.key, db = key.endsWith("threshold");
  el.addEventListener("input", () => document.getElementById(key + "-v").textContent = db ? fmtDb(el.value) : el.value);
  el.addEventListener("change", () => change("/api/set", {key, value: el.value}));
});
Object.keys(SWATCH).forEach((name, idx) => {
  const w = document.createElement("button");
  w.className = "swatch"; w.dataset.idx = idx; w.title = name; w.setAttribute("aria-label", name);
  w.style.background = SWATCH[name];
  w.addEventListener("click", () => change("/api/set", {key: "colour", value: name}));
  $("#swatches").appendChild(w);
});
$("#eq").addEventListener("click", e => {
  const t = e.target.closest('button[data-field="on"]'); if (!t) return;
  change("/api/eq", {band: t.closest("tr").dataset.band, on: t.dataset.on !== "1"});
});
$("#eq").addEventListener("change", e => {
  const el = e.target; if (!el.dataset.field || el.value === "") return;
  change("/api/eq", {band: el.closest("tr").dataset.band, [el.dataset.field]: Number(el.value)});
});

// level meter: approx dBFS from the mic's 0x2034 packets, shown on a -60..0 dB scale
const FLOOR = -60;
let peak = FLOOR, peakAt = 0;
const pct = d => Math.max(0, Math.min(100, (d - FLOOR) / -FLOOR * 100));
async function meter() {
  if (document.hidden) return;
  let m;
  try { m = await api("/api/meter"); } catch (e) { return; }
  const fill = $("#meter-fill"), pk = $("#meter-peak"), meterEl = fill.parentElement;
  meterEl.style.setProperty("--meter-w", meterEl.clientWidth + "px");
  if (m.db === null || m.age === null || m.age > 0.5) {
    fill.style.width = "0"; pk.style.display = "none"; $("#meter-v").textContent = "no signal";
    meterEl.setAttribute("aria-valuenow", FLOOR); peak = FLOOR; return;
  }
  const now = performance.now();
  if (m.db >= peak || now - peakAt > 1500) { peak = m.db; peakAt = now; }
  fill.style.width = pct(m.db) + "%";
  pk.style.display = "block"; pk.style.left = `calc(${pct(peak)}% - 2px)`;
  $("#meter-v").textContent = m.db.toFixed(1) + " dB";
  meterEl.setAttribute("aria-valuenow", m.db);
}

refresh(); setInterval(refresh, 2000); setInterval(meter, 100);
</script>
</body>
</html>
