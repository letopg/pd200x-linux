<script>
const SWATCH = {white:"#ffffff", red:"#e53935", orange:"#fb8c00", yellow:"#fdd835", green:"#43a047",
  cyan:"#00bcd4", blue:"#1e63e9", pink:"#ec4fa6",
  "rgb-wave":"conic-gradient(red, yellow, lime, cyan, blue, magenta, red)",
  "rgb-static":"linear-gradient(135deg, red, lime, blue)"};
const BANDS = ["1","2","3","4","5","hpf","lpf"];
const $ = s => document.querySelector(s);
let busy = false;

function showErr(msg) { const e = $("#err"); e.textContent = msg || ""; e.style.display = msg ? "block" : "none"; }

async function api(path, body) {
  const r = await fetch(path, body ? {method: "POST", headers: {"Content-Type": "application/json"},
                                      body: JSON.stringify(body)} : {});
  const j = await r.json().catch(() => ({error: r.statusText}));
  if (!r.ok) throw new Error(j.error || r.statusText);
  return j;
}

function setToggle(key, on) {
  const b = document.querySelector(`button[data-key="${key}"]`);
  b.classList.toggle("on", !!on); b.textContent = on ? "on" : "off"; b.dataset.on = on ? "1" : "0";
}
function setSlider(key, v, fmt) {
  const el = document.getElementById(key); if (v === null || v === undefined) return;
  if (document.activeElement !== el) el.value = v;
  document.getElementById(key + "-v").textContent = fmt ? fmt(v) : v;
}
const fmtDb = v => (v > 0 ? "+" : "") + Number(v).toFixed(1) + " dB";

function render(s) {
  $("#ident").textContent = `${s.identity.model} · firmware ${s.identity.firmware} · ${s.path}`;
  setToggle("mute", s.mute); setToggle("monitor", s.monitoring);
  setSlider("mic-volume", s.mic_volume);
  setToggle("light", s.light.on); setSlider("brightness", s.light.brightness);
  document.querySelectorAll(".swatch").forEach(w => w.classList.toggle("sel", +w.dataset.idx === s.light.colour));
  setToggle("compressor", s.compressor.on); setSlider("compressor-threshold", s.compressor.threshold_db, fmtDb);
  setToggle("limiter", s.limiter.on); setSlider("limiter-threshold", s.limiter.threshold_db, fmtDb);
  const tb = $("#eq");
  if (!s.eq) { tb.innerHTML = '<tr><td colspan="6">EQ not readable (needs firmware 1.2.x)</td></tr>'; return; }
  if (!tb.children.length || tb.children.length !== s.eq.length) {
    tb.innerHTML = "";
    s.eq.forEach((b, i) => {
      const filt = b.type === "low-pass" || b.type === "high-pass";
      const tr = document.createElement("tr"); tr.dataset.band = BANDS[i];
      tr.innerHTML = `<td>${b.name}</td>
        <td><button class="toggle" data-field="on"></button></td>
        <td>${b.type}</td>
        <td><input type="number" data-field="freq" min="20" max="22000" step="1"></td>
        <td>${filt ? "" : '<input type="number" data-field="gain" min="-12" max="12" step="0.5">'}</td>
        <td><input type="number" data-field="q" min="0.1" max="10" step="0.05"></td>`;
      tb.appendChild(tr);
    });
  }
  s.eq.forEach((b, i) => {
    const tr = tb.children[i];
    const t = tr.querySelector('[data-field="on"]');
    t.classList.toggle("on", b.on); t.textContent = b.on ? "on" : "off"; t.dataset.on = b.on ? "1" : "0";
    const put = (f, v) => { const el = tr.querySelector(`[data-field="${f}"]`);
      if (el && document.activeElement !== el) el.value = v; };
    put("freq", b.freq_hz); put("gain", b.gain_db); put("q", b.q.toFixed(2));
  });
}

async function refresh() {
  if (busy) return;
  try { render(await api("/api/status")); showErr(""); } catch (e) { showErr(e.message); }
}
async function change(path, body) {
  busy = true;
  try { await api(path, body); showErr(""); } catch (e) { showErr(e.message); }
  busy = false; refresh();
}

document.querySelectorAll("button.toggle[data-key]").forEach(b =>
  b.addEventListener("click", () => change("/api/set", {key: b.dataset.key, value: b.dataset.on === "1" ? "off" : "on"})));
