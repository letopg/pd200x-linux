#!/usr/bin/env python3
"""pd200x-web - local web UI for the Maono PD200X.

  pd200x-web [--port 8200]     then open http://127.0.0.1:8200/

Listens on 127.0.0.1 only. API:
  GET  /api/status                       identity + decoded settings
  GET  /api/meter                        latest level {"db": float|null, "age": seconds|null}
  POST /api/set  {"key": K, "value": V}  same keys and values as `pd200xctl set`
  POST /api/eq   {"band": B, "on"?, "freq"?, "gain"?, "q"?}
"""
import argparse
import json
import os
import select
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pd200x  # noqa: E402

